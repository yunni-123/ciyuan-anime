i.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/30/29/505472_C5CTi.jpg"},"rating":{"rank":507,"total":347,"count":{"1":1,"2":0,"3":0,"4":0,"5":8,"6":10,"7":65,"8":145,"9":81,"10":37},"score":8.1},"collection":{"on_hold":29,"dropped":19,"wish":853,"collect":238,"doing":429},"annualRank":1,"sourceUrl":"https://bgm.tv/subject/505472","resources":[{"name":"BOOK☆WALKER 出版检索","url":"https://bookwalker.jp/search/?word=%E3%81%93%E3%81%A1%E3%82%89%E3%80%81%E7%B5%82%E6%9C%AB%E5%81%9C%E6%BB%9E%E5%A7%94%E5%93%A1%E4%BC%9A%E3%80%82","kind":"search"},{"name":"Kindle 出版检索","url":"https://www.amazon.co.jp/s?k=%E3%81%93%E3%81%A1%E3%82%89%E3%80%81%E7%B5%82%E6%9C%AB%E5%81%9C%E6%BB%9E%E5%A7%94%E5%93%A1%E4%BC%9A%E3%80%82&i=digital-text","kind":"search"}],"resourceState":"search-only","metadataCheckedAt":"2026-10-26T05:22:34.266Z","bookKind":"novels","sourceYear":2024},{"id":385991,"name":"わたしはあなたの涙になりたい","name_cn":"我想成为你的眼泪","date":"2022-07-20","platform":"小说","tags":[{"name":"轻小说","count":241,"total_count":138035},{"name":"四季大雅","count":151,"total_count":218},{"name":"恋爱","count":133,"total_count":76158},{"name":"催泪","count":110,"total_count":586},{"name":"悲剧","count":84,"total_count":293},{"name":"生死","count":61,"total_count":229},{"name":"小说","count":50,"total_count":60466},{"name":"2022","count":48,"total_count":5432},{"name":"绝症","count":45,"total_count":225},{"name":"一卷全","count":42,"total_count":1706},{"name":"轻文学","count":34,"total_count":2323},{"name":"ががが","count":10,"total_count":46},{"name":"单卷","count":7,"total_count":945},{"name":"ガガガ文庫","count":4,"total_count":653}],"summary":"これは、涙で始まり、涙で終わる物語。\r\n\r\n全身が塩に変わって崩れていく奇病「塩化病」。その病で母親を亡くした少年・三枝八雲は、小学校の音楽室でひとりの少女と出会った。\r\n\r\n美しく天才的なピアノ奏者であるその少女の名は、五十嵐揺月。鍵盤に触れる繊細なその指でいじめっ子の鼻を掴みひねり上げ、母親の過剰な期待に応えるべく人知れず努力する。さまざまな揺月の姿を誰よりも近いところから見ていた八雲は、我知らず彼女に心惹かれていく。\r\n\r\n小学校を卒業し、ますます美しく魅力的に成長した揺月は、人々の崇拝と恋慕の対象となっていった。高校に進学する頃、すでにプロのピアニストとして活躍していた揺月はイタリアへと留学してしまう。世界を舞台にする揺月と、何者でもない自分との間にある圧倒的な差を痛感した八雲は、やがて小説を書き始める。\r\n\r\n揺月との再会はある日唐突に訪れた――その再会が、自分の運命を大きく変えるものになることをその時の彼は知る由もなかった。\r\n\r\nこれは、涙で始まり、涙で終わる物語。","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/ce/14/385991_Bfyia.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/ce/14/385991_Bfyia.jpg","large":"https://lain.bgm.tv/pic/cover/l/ce/14/385991_Bfyia.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/ce/14/385991_Bfyia.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/ce/14/385991_Bfyia.jpg"},"rating":{"rank":3162,"total":637,"count":{"1":2,"2":1,"3":13,"4":19,"5":39,"6":93,"7":139,"8":182,"9":103,"10":46},"score":7.4},"collection":{"on_hold":12,"dropped":14,"wish":460,"collect":822,"doing":42},"annualRank":1,"sourceUrl":"https://bgm.tv/subject/385991","resources":[{"name":"BOOK☆WALKER 出版检索","url":"https://bookwalker.jp/search/?word=%E3%82%8F%E3%81%9F%E3%81%97%E3%81%AF%E3%81%82%E3%81%AA%E3%81%9F%E3%81%AE%E6%B6%99%E3%81%AB%E3%81%AA%E3%82%8A%E3%81%9F%E3%81%84","kind":"search"},{"name":"Kindle 出版检索","url":"https://www.amazon.co.jp/s?k=%E3%82%8F%E3%81%9F%E3%81%97%E3%81%AF%E3%81%82%E3%81%AA%E3%81%9F%E3%81%AE%E6%B6%99%E3%81%AB%E3%81%AA%E3%82%8A%E3%81%9F%E3%81%84&i=digital-text","kind":"search"}],"resourceState":"search-only","metadataCheckedAt":"2026-10-26T05:22:34.266Z","bookKind":"novels","sourceYear":2022},{"id":410317,"name":"僕らは『読み』を間違える","name_cn":"我们在「解读」上犯了错误","date":"2022-12-01","platform":"小说","tags":[{"name":"轻小说","count":184,"total_count":138034},{"name":"恋爱","count":114,"total_count":76155},{"name":"青春","count":87,"total_count":14721},{"name":"水鏡月聖","count":71,"total_count":121},{"name":"小说","count":49,"total_count":60465},{"name":"轻厉","count":40,"total_count":60},{"name":"角川スニーカー文庫","count":35,"total_count":667},{"name":"推理","count":34,"total_count":22379},{"name":"扭曲","count":29,"total_count":3645},{"name":"2023","count":18,"total_count":3818},{"name":"日本","count":18,"total_count":52714},{"name":"原创","count":17,"total_count":25512},{"name":"系列","count":14,"total_count":27229},{"name":"小说系列","count":11,"total_count":7349}],"summary":"学生という生き物は、日々「わからないこと」の答えを探している。\r\n明日のテストの解答、クラス内の評判、好きなあの子が好きな人。\r\nかく言う僕・竹久優真も、とある問いに直面していた。\r\n消しゴムに書かれていた『あなたのことが好きです』について。\r\nそれは憧れの文学少女・若宮雅との両想いを確信した証拠であり、しかしその恋は玉砕に終わった。\r\nつまり他の誰かが？\r\n高校に入学した春、その“勘違い”は動き出す。\r\n「ちょうどいいところにいた。ちょっと困っていたとこなんだよ」\r\n太陽少女・宗像瀬奈が拾い集めてくる学園の小さな謎たち――\r\nそれらは、いくつもの恋路が絡みあう事件《ミステリー》だったんだ。","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/7a/91/410317_fqTEC.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/7a/91/410317_fqTEC.jpg","large":"https://lain.bgm.tv/pic/cover/l/7a/91/410317_fqTEC.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/7a/91/410317_fqTEC.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/7a/91/410317_fqTEC.jpg"},"rating":{"rank":467,"total":374,"count":{"1":0,"2":0,"3":2,"4":0,"5":5,"6":17,"7":64,"8":146,"9":106,"10":34},"score":8.1},"collection":{"on_hold":33,"dropped":12,"wish":535,"collect":367,"doing":206},"annualRank":2,"sourceUrl":"https://bgm.tv/subject/410317","resources":[{"name":"BOOK☆WALKER 出版检索","url":"https://bookwalker.jp/search/?word=%E5%83%95%E3%82%89%E3%81%AF%E3%80%8E%E8%AA%AD%E3%81%BF%E3%80%8F%E3%82%92%E9%96%93%E9%81%95%E3%81%88%E3%82%8B","kind":"search"},{"name":"Kindle 出版检索","url":"https://www.amazon.co.jp/s?k=%E5%83%95%E3%82%89%E3%81%AF%E3%80%8E%E8%AA%AD%E3%81%BF%E3%80%8F%E3%82%92%E9%96%93%E9%81%95%E3%81%88%E3%82%8B&i=digital-text","kind":"search"}],"resourceState":"search-only","metadataCheckedAt":"2026-10-26T05:22:34.266Z","bookKind":"novels","sourceYear":2022},{"id":300270,"name":"わたしが恋人になれるわけないじゃん、ムリムリ！（※ムリじゃなかった!?）","name_cn":"我们不可能成为恋人！绝对不行。 (※似乎可行？)","date":"2020-02-21","platform":"小说","tags":[{"name":"百合","count":449,"total_count":70309},{"name":"轻小说","count":323,"total_count":138028},{"name":"みかみてれん","count":131,"total_count":418},{"name":"后宫","count":128,"total_count":20647},{"name":"竹嶋えく","count":120,"total_count":400},{"name":"恋爱","count":102,"total_count":76147},{"name":"欢乐","count":93,"total_count":1064},{"name":"小说","count":80,"total_count":60462},{"name":"屑粉毛","count":78,"total_count":83},{"name":"日本","count":65,"total_count":52676},{"name":"校园","count":62,"total_count":40331},{"name":"日常","count":54,"total_count":21321},{"name":"2020","count":41,"total_count":7592},{"name":"GL","count":36,"total_count":1394}],"summary":"「我再也不要孤零零的了！我要赢得最棒的高中生活！」\r\n\r\n舍弃孤零零的中学时代，在高中初次亮相的我——甘织玲奈子。\r\n但我本性阴暗，没办法习惯我所憧憬的阳光生活，要窒息了！就在这时，因为一些意外我与我们学校的超级巨星·王塚真唯成为了共享彼此烦恼的密友。\r\n\r\n只要有真唯在，我每天都能努力——本应如此！\r\n\r\n「我……爱上你了」\r\n\r\n「等等！说好的做朋友呢」\r\n\r\n恋人什么的是不稳定的关系，不行！我想交到最棒的朋友享受高中生活！\r\n\r\n但真唯似乎也不能完全放下恋心——。\r\n\r\n「一决胜负吧，看看符合我们的关系到底是恋人还是挚友」\r\n\r\n如此这般，赌上两人关系的马不停蹄的爱情喜剧，开幕！\r\n\r\n個人出版レーベル『みかみてれん文庫』でKindleライトノベルランキング上位を席巻した、みかみてれん先生の完全新作ガールズラブコメが遂に登場!\r\n\r\nタイトルは──、『わたしが恋人になれるわけないじゃん、ムリムリ!(※ムリじゃなかった!?)』(略称:わたなれ)\r\n\r\nイラストをご担当されるのは、漫画やアニメのキャラクター原案で大活躍中の竹嶋えく先生!\r\n最強タッグでお届けする、最高のノンストップ・ガールズラブコメディに、ご期待ください!!\r\n\r\n「二度とぼっちなんかに戻らない! 勝ち取るんだ、最高の高校生活を! 」\r\n\r\nぼっちな中学時代を捨て、高校デビューしたわたし・甘織れな子。\r\nでも、根が陰キャだから憧れの陽キャ生活に馴染めず、窒息寸前!\r\nそんなとき、我が校のスーパースター・王塚真唯とひょんなことからお互いの悩みを共有してヒミツの友達に。\r\n真唯がいれば毎日がんばれそう──と思ったはずが!\r\n\r\n「君に、恋をしてしまったんだ」\r\n「待って! 友達どこいった」\r\n\r\n恋人なんて不安定な関係、ムリ! わたしは最高の友達を作って高校生活を楽しみたいの!\r\nでも真唯も恋心を諦めきれないようで──。\r\n\r\n「恋人と親友のどちらが私たちにふさわしいか、勝負で決めよう」\r\n\r\nこうして、ふたりの在り方を懸けたノンストップ・ラブコメディが幕を開けたのだった!","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/ec/bf/300270_M30S6.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/ec/bf/300270_M30S6.jpg","large":"https://lain.bgm.tv/pic/cover/l/ec/bf/300270_M30S6.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/ec/bf/300270_M30S6.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/ec/bf/300270_M30S6.jpg"},"rating":{"rank":3701,"total":798,"count":{"1":1,"2":3,"3":7,"4":10,"5":28,"6":109,"7":282,"8":279,"9":53,"10":26},"score":7.3},"collection":{"on_hold":78,"dropped":51,"wish":542,"collect":647,"doing":854},"annualRank":1,"sourceUrl":"https://bgm.tv/subject/300270","resources":[{"name":"BOOK☆WALKER 出版检索","url":"https://bookwalker.jp/search/?word=%E3%82%8F%E3%81%9F%E3%81%97%E3%81%8C%E6%81%8B%E4%BA%BA%
{"id":279055,"bangumiId":279055,"type":2,"name":"武者・騎士・コマンド SDガンダム緊急出撃","name_cn":"","date":"1991-03-16","year":"1991","region":"jp","platform":"剧场版","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/2c/59/279055_rD8hH.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/2c/59/279055_rD8hH.jpg","large":"https://lain.bgm.tv/pic/cover/l/2c/59/279055_rD8hH.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/2c/59/279055_rD8hH.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/2c/59/279055_rD8hH.jpg"},"summary":"与《机动战士高达F91》一同上映的SD高达剧场动画短片。 \r\n平和な街に突如あらわれた宇宙大魔王は、永遠の命を手に入れるため、「生命の樹」を使って人々の命を吸い取っていった。博士とその孫リプリンは大魔王に対抗するため、転送機を使いヒーローを呼び出したが、現れたのは武者頑駄無、騎士ガンダム、コマンドガンダムの三人。それぞれの世界とは全く違う異世界に召喚された勇者達三人は、博士とリプリンからの説明で事情を理解し、巨大な悪と戦うことを決意。宇宙大魔王とその配下たちに戦いを挑むのであった。","rating":{"rank":0,"total":17,"count":{"1":0,"2":1,"3":2,"4":3,"5":5,"6":5,"7":0,"8":1,"9":0,"10":0},"score":4.9},"collection":{"on_hold":3,"dropped":6,"wish":15,"collect":26,"doing":3},"tags":[{"name":"1991","count":9,"total_count":3366},{"name":"剧场版","count":8,"total_count":729165},{"name":"SUNRISE","count":5,"total_count":92825},{"name":"原创","count":3,"total_count":625404},{"name":"高达","count":2,"total_count":41972},{"name":"萝卜","count":2,"total_count":52806},{"name":"GUNDAM","count":2,"total_count":12050},{"name":"机战","count":2,"total_count":50799},{"name":"神田武幸","count":2,"total_count":349},{"name":"SD","count":2,"total_count":136},{"name":"奇幻","count":2,"total_count":476950},{"name":"OVA","count":2,"total_count":367280},{"name":"サンライズ","count":1,"total_count":1565},{"name":"喜剧","count":1,"total_count":36077},{"name":"日本","count":1,"total_count":302047},{"name":"1991年","count":1,"total_count":192}],"eps":1,"total_episodes":1,"aliases":["武者・騎士・コマンド SDガンダム緊急出撃"],"sourceType":"bibliography","nsfw":false,"metadataCheckedAt":"2026-10-26T04:01:20.715Z"}
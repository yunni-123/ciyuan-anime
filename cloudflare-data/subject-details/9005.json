{"id":9005,"bangumiId":9005,"type":2,"name":"ドラゴンボールZ","name_cn":"龙珠Z","date":"1989-04-26","year":"1989","region":"jp","platform":"TV","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/68/72/9005_XZmlL.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/68/72/9005_XZmlL.jpg","large":"https://lain.bgm.tv/pic/cover/l/68/72/9005_XZmlL.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/68/72/9005_XZmlL.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/68/72/9005_XZmlL.jpg"},"summary":"龙珠Z（日文：ドラゴンボールZ，英文：DRAGON BALL Z）是指日本漫画家鸟山明的漫画《七龙珠》第195篇-第519篇，因为这期间鸟山明的漫画风格转为超激战，而且故事也和前194篇风格没有太大变化，因此由东映动画公司改编成为独立的动画片。题目中的\"Z\"代表着ZENKAI(日文\"全开\")之意。龙珠Z故事发生于《龙珠》后五年的世界，讲述孙悟空和同伴保卫地球的故事。","rating":{"rank":131,"total":4130,"count":{"1":9,"2":4,"3":4,"4":9,"5":43,"6":226,"7":711,"8":1500,"9":961,"10":663},"score":8.2},"collection":{"on_hold":225,"dropped":115,"wish":478,"collect":7216,"doing":239},"tags":[{"name":"龙珠","count":832,"total_count":6650},{"name":"童年","count":723,"total_count":95454},{"name":"鸟山明","count":616,"total_count":3217},{"name":"热血","count":535,"total_count":221166},{"name":"超级赛亚人","count":454,"total_count":478},{"name":"TV","count":454,"total_count":1458716},{"name":"战斗","count":360,"total_count":496180},{"name":"东映","count":281,"total_count":21350},{"name":"漫画改","count":266,"total_count":900331},{"name":"JUMP","count":259,"total_count":33977},{"name":"1989","count":245,"total_count":6266},{"name":"热血系","count":241,"total_count":6138},{"name":"漫改","count":99,"total_count":373198},{"name":"金发不良","count":67,"total_count":67},{"name":"1989年","count":66,"total_count":307},{"name":"日本","count":58,"total_count":321762},{"name":"超.拖戲","count":32,"total_count":32},{"name":"東映アニメーション","count":25,"total_count":10138},{"name":"经典","count":24,"total_count":23407},{"name":"又燃又基","count":23,"total_count":56},{"name":"西尾大介","count":19,"total_count":236},{"name":"东映动画","count":18,"total_count":7595},{"name":"长篇","count":14,"total_count":2182},{"name":"神作","count":14,"total_